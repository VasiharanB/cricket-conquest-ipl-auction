# ============================================================
# Cricket Conquest Server — Environment Variables
# ============================================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------
# Database Configuration (Option A: Individual parameters)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cricket_conquest
DB_SSL=true

# ------------------------------------------------------------
# Database Configuration (Option B: Cloud Connection URL)
# (Used by TiDB Cloud, Aiven, Railway, AWS RDS, etc.)
# ------------------------------------------------------------
# DATABASE_URL=mysql://user:password@host:port/cricket_conquest?ssl-mode=REQUIRED

# ------------------------------------------------------------
# Security & JWT Secrets
# ------------------------------------------------------------
JWT_SECRET=zentrix26_cricket_conquest_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------
# Tournament Rules
# ------------------------------------------------------------
DEFAULT_PURSE=50.00
MIN_SQUAD_SIZE=15
MAX_SQUAD_SIZE=15
